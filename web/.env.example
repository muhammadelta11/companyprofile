# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XaxEYEDuPJV--bZwW9eWsw_ZavBW5b1
# Server-only — dipakai admin buat akun anggota (jangan expose ke browser / NEXT_PUBLIC_)
# Boleh pakai salah satu: service_role lama, atau secret key baru (sb_secret_…)
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Delta AI — prefer Groq (gratis): https://console.groq.com/keys (server-only)
GROQ_API_KEY=
# Opsional; default llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile

# Fallback opsional (Google AI Studio, sering berbayar)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Cloudflare Turnstile (Dashboard → Turnstile → Add widget)
# Domains: localhost, 127.0.0.1, masudeltamamy.com, www.masudeltamamy.com
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# Opsional; default: masudeltamamy.com,www.masudeltamamy.com (+ localhost di development)
TURNSTILE_HOSTNAMES=masudeltamamy.com,www.masudeltamamy.com
