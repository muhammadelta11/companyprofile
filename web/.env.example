# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XaxEYEDuPJV--bZwW9eWsw_ZavBW5b1
# Server-only — dipakai admin buat akun anggota (jangan expose ke browser / NEXT_PUBLIC_)
